# Copy to deploy/.env and fill in.

# Token expected in the X-Deploy-Token header of deploy requests (e.g. openssl rand -hex 32).
DEPLOY_TOKEN=

# Telegram bot token (@BotFather) and target chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Host paths to the application repositories and the branches that get deployed.
BACKEND_DIR=/srv/github/bvb-site-backend
BACKEND_BRANCH=develop
FRONTEND_DIR=/srv/github/bvb-site-frontend
FRONTEND_BRANCH=main

# Host port the webhook listens on at 127.0.0.1 (outside access goes through the reverse proxy).
DEPLOY_WEBHOOK_PORT=9000

# Host path to the SSH key with read access to the repositories cloned over SSH (no passphrase).
DEPLOY_SSH_KEY=/root/.ssh/github
